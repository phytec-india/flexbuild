build_distro_rfs_debian() {
    [ $DISTROTYPE = debian -a -f $RFSDIR/etc/buildinfo ] && log_mute echo $RFSDIR already exists! && exit 0
    [ `whoami` = root ] && sudopt="" || sudopt=sudo

    fbprint_n "Generating initial rootfs: $RFSDIR ... \\nThis might take some time, please be patient" && cd $FBDIR
    test -c $RFSDIR/dev/pts/ptmx && $sudopt umount $RFSDIR/dev/pts
    test -f $RFSDIR/proc/uptime && $sudopt umount $RFSDIR/proc
    [ -n "$RFSDIR" ] && $sudopt rm -rf $RFSDIR/*

    if [ "$FETCH_PREBUILT_SDK_RFS" = y -a "$FORCE" != y ]; then
	echo FETCH_PREBUILT_SDK_RFS is enable by default in $CFGLISTYML
	rootfsn=rootfs_${DISTRIB_VERSION}_${DISTROTYPE}_${DISTROVARIANT}_${DESTARCH}.tar.zst
	rootfs_url=$DISTRO_SVR_URL/$DISTRIB_VERSION/$rootfsn
	if [ ! -f $FBOUTDIR/images/$rootfsn ]; then
	   cd $FBOUTDIR/images
	   log_mute wget --progress=bar:force $rootfs_url || true
	   cd -
	fi
	[ -f $FBOUTDIR/images/$rootfsn ] && echo Extracting $rootfsn && \
	$sudopt tar -I zstd -xf $FBOUTDIR/images/$rootfsn -C $RFSDIR && \
	fbprint_d $RFSDIR && exit || echo Building $RFSDIR from scratch
    fi

    if [ ! -f $PKGDIR/${DEBIAN_CODENAME}_${DISTROVARIANT}_$DESTARCH/rootfs/etc/buildinfo ]; then
			  [ -f /usr/bin/bdebstrap ] || log_mute $sudopt apt install -y bdebstrap

			  # Ensure we have a local Debian archive keyring for mmdebstrap to use
			  kr_dir="$FBDIR/tools/keys"
			  kr="$kr_dir/debian-archive-keyring.gpg"
			  if [ ! -f "$kr" ]; then
					fbprint_n "Downloading Debian archive keyring..."
					mkdir -p "$kr_dir"
					cd "$kr_dir" || exit 1
					keyring_deb=debian-archive-keyring_2025.1_all.deb
					keyring_url=https://ftp.debian.org/debian/pool/main/d/debian-archive-keyring/$keyring_deb
					if [ ! -f "$keyring_deb" ]; then
						 wget -q "$keyring_url" || { fbprint_e "Failed to download $keyring_url"; exit 1; }
					fi
					dpkg-deb -x "$keyring_deb" temp_keyring
					cp -f temp_keyring/usr/share/keyrings/debian-archive-keyring.gpg "$kr"
					rm -rf temp_keyring "$keyring_deb"
					fbprint_d "Debian keyring installed at $kr"
					# Make the keyring available where mmdebstrap commonly expects it.
					# Place copies inside the build tree so no system changes are required.
					mkdir -p "$FBDIR/components_${DISTRIB_VERSION}/usr/share/keyrings"
					cp -f "$kr" "$FBDIR/components_${DISTRIB_VERSION}/usr/share/keyrings/debian-archive-keyring.gpg"
					mkdir -p "$FBDIR/usr/share/keyrings"
					cp -f "$kr" "$FBDIR/usr/share/keyrings/debian-archive-keyring.gpg"
					# If sudo is available, also install to host /usr/share/keyrings so absolute
					# paths in YAML (e.g. /usr/share/keyrings/...) are satisfied. This is optional.
					if command -v sudo >/dev/null 2>&1; then
						$sudopt mkdir -p /usr/share/keyrings || true
						$sudopt cp -f "$kr" /usr/share/keyrings/debian-archive-keyring.gpg || true
					fi
					cd $FBDIR || exit 1
			  fi

			  keyringopt=""; [ -f "$kr" ] && keyringopt="--keyring=$kr"

			  [ -f $PKGDIR/${DEBIAN_CODENAME}_${DISTROVARIANT}_$DESTARCH ] || \
			  log_mute $sudopt bdebstrap -c $FBDIR/configs/debian/${DISTROTYPE}_${DISTROVARIANT}_${DESTARCH}.yaml --name \
					 $PKGDIR/${DEBIAN_CODENAME}_${DISTROVARIANT}_$DESTARCH $keyringopt $mirroropt -f
    fi

    [ -f $RFSDIR/etc/buildinfo ] || $sudopt rsync -aHAX $PKGDIR/${DEBIAN_CODENAME}_${DISTROVARIANT}_$DESTARCH/rootfs/* $RFSDIR

    if [ $DISTROVARIANT = server -o $DISTROVARIANT = desktop ]; then
	log_mute $sudopt chroot $RFSDIR apt update
	[ $DISTROVARIANT = server ] && log_mute $sudopt chroot $RFSDIR apt install -y $extra_server_devel_packages
	[ $DISTROVARIANT = desktop ] && log_mute $sudopt chroot $RFSDIR apt install -y $extra_server_devel_packages $extra_desktop_devel_packages

	# set U-Boot version info in userland to be readable in linux runtime
	[ -d $FBOUTDIR/bsp/u-boot ] && uvfile=$(find $FBOUTDIR/bsp/u-boot/*/output/*/include/generated -name version_autogenerated.h | head -1)
	if [ -n "$uvfile" -a -f $uvfile ]; then
	    ubootVersion=`head -1 $uvfile | cut -d' ' -f3`
	    ubootVersion=`echo $ubootVersion | sed 's/\"//g'`
	    echo -e "Bootloader Version: U-Boot $ubootVersion" | $sudopt tee -a $RFSDIR/etc/buildinfo 1>/dev/null
	fi

	# clean cached packages
	log_mute $sudopt chroot $RFSDIR apt clean
	log_mute $sudopt chroot $RFSDIR apt autoclean
	log_mute $sudopt chroot $RFSDIR apt autoremove -y
    fi

    # fix absolute path for libz.so symlink when cross compiling apitrace
    $sudopt ln -sf libz.so.1 $RFSDIR/usr/lib/aarch64-linux-gnu/libz.so

    # fixup for libtinfo.so needed by tsntool
    $sudopt ln -sf libtinfo.so.6 $RFSDIR/usr/lib/aarch64-linux-gnu/libtinfo.so

    # fixup for Qt6 app cross-compiling
    $sudopt ln -sf libQt6Quick.so.6 $RFSDIR/usr/lib/aarch64-linux-gnu/libQt6Quick.so
    $sudopt ln -sf libQt6OpenGL.so.6 $RFSDIR/usr/lib/aarch64-linux-gnu/libQt6OpenGL.so
    $sudopt ln -sf libQt6QmlModels.so.6 $RFSDIR/usr/lib/aarch64-linux-gnu/libQt6QmlModels.so
    $sudopt ln -sf libQt6Qml.so.6 $RFSDIR/usr/lib/aarch64-linux-gnu/libQt6Qml.so

    echo -e 'export PYTHONPATH=$PYTHONPATH:/usr/lib/python3.11/site-packages:/usr/lib/python3/dist-packages' | $sudopt tee -a $RFSDIR/etc/profile 1>/dev/null

    # fix ping: socket: Operation not permitted
    $sudopt chmod u+s $RFSDIR/bin/ping

	# fix login issue for desktop
	if [ $DISTROVARIANT = desktop ]; then
		$sudopt sed -i "s/.*pam_nologin.*/auth    requisite       pam_nologin.so nullok/" $RFSDIR/etc/pam.d/gdm-password
		$sudopt sed -e  's/.*AutomaticLoginEnable.*/AutomaticLoginEnable = true/'  -e '0,/user1/s/.*user1.*/AutomaticLogin = debian/'  -i $RFSDIR/etc/gdm3/daemon.conf
		$sudopt sed -i '$a\[Install]\nWantedBy=graphical.target\n' $RFSDIR/lib/systemd/system/gdm.service
		$sudopt rm -rf $RFSDIR/etc/systemd/system/display-manager.service
		$sudopt ln -sf /lib/systemd/system/gdm.service $RFSDIR/etc/systemd/system/graphical.target.wants/gdm.service
	fi

	# NOTE: The following firmware and modules installation is ONLY for imx8mm_phygate-tauri-l.
	# For other boards, this step is not performed.
	# Install firmware and modules for imx8mm_phygate-tauri-l
	if [ "$MACHINE" = "imx8mm_phygate-tauri-l" ]; then
		imgdir=$FBOUTDIR/images/boot_IMX_arm64_phytec
		# Remove symlinks or non-directories for /lib/firmware and /lib/modules before copying
		if [ -L "$RFSDIR/lib/firmware" ] || { [ -e "$RFSDIR/lib/firmware" ] && [ ! -d "$RFSDIR/lib/firmware" ]; }; then
			fbprint_n "[DEBUG] Removing symlink or non-directory $RFSDIR/lib/firmware ..."
			ls -l "$RFSDIR/lib/firmware" || true
			$sudopt rm -f "$RFSDIR/lib/firmware"
			fbprint_n "[DEBUG] Removed $RFSDIR/lib/firmware"
		fi
		if [ -L "$RFSDIR/lib/modules" ] || { [ -e "$RFSDIR/lib/modules" ] && [ ! -d "$RFSDIR/lib/modules" ]; }; then
			fbprint_n "[DEBUG] Removing symlink or non-directory $RFSDIR/lib/modules ..."
			ls -l "$RFSDIR/lib/modules" || true
			$sudopt rm -f "$RFSDIR/lib/modules"
			fbprint_n "[DEBUG] Removed $RFSDIR/lib/modules"
		fi
		# Show state before copy
		fbprint_n "[DEBUG] Before copy: ls -ld $RFSDIR/lib/firmware $RFSDIR/lib/modules"
		ls -ld "$RFSDIR/lib/firmware" "$RFSDIR/lib/modules" || true
		# Copy firmware and modules folders if they exist
		if [ -d "$imgdir/firmware" ]; then
			fbprint_n "[DEBUG] Copying $imgdir/firmware/* to $RFSDIR/lib/firmware"
			$sudopt mkdir -p "$RFSDIR/lib/firmware"
			$sudopt cp -a "$imgdir/firmware/." "$RFSDIR/lib/firmware/"
			fbprint_d "Copied firmware contents to $RFSDIR/lib/firmware"
		else
			fbprint_w "Firmware folder not found at $imgdir/firmware"
		fi
		if [ -d "$imgdir/modules" ]; then
			fbprint_n "[DEBUG] Copying $imgdir/modules/* to $RFSDIR/lib/modules"
			$sudopt mkdir -p "$RFSDIR/lib/modules"
			$sudopt cp -a "$imgdir/modules/." "$RFSDIR/lib/modules/"
			fbprint_d "Copied modules contents to $RFSDIR/lib/modules"
		else
			fbprint_w "Modules folder not found at $imgdir/modules"
		fi
		# Show state after copy
		fbprint_n "[DEBUG] After copy: ls -ld $RFSDIR/lib/firmware $RFSDIR/lib/modules"
		ls -ld "$RFSDIR/lib/firmware" "$RFSDIR/lib/modules" || true

	fi

	fbprint_d $RFSDIR
	}